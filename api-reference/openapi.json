                            },
                            "description": {
                              "type": "string",
                              "nullable": true
                            },
                            "image": {
                              "type": "string",
                              "nullable": true
                            },
                            "domain": {
                              "type": "string"
                            },
                            "source": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string",
                                "nullable": true
                              },
                              "description": "Which tag each value was resolved from."
                            },
                            "approximate": {
                              "type": "boolean",

                            },
                            "basis": {
                              "type": "string",
                              "description": "Plain-English statement of this platform's rules."
                            },
                            "favicon": {
                              "type": "string",
                              "nullable": true
                            }
                          }
                        },
                        "facebook": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string",
                              "nullable": true
                            },
                            "description": {
                              "type": "string",
                              "nullable": true
                            },
                            "image": {
                              "type": "string",
                              "nullable": true
                            },

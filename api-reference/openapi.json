                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "headers": {
              "x-ratelimit-limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Checks allowed per hour."
              },
              "x-ratelimit-remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-reset": {
